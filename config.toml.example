# CARTA Go Configuration Example
# Copy this file to /etc/carta/config.toml and adjust values as needed
# Configuration can also be set via environment variables with CARTA_ prefix
# Example: CARTA_CONTROLLER_PORT=8081

# ============================================================================
# Global Settings
# ============================================================================

# Environment mode: development, production, etc.
environment = "development"

# Logging level: debug, info, warn, error
log_level = "info"

# ============================================================================
# Logging Configuration
# ============================================================================
[logging]

# Directory for CARTA service log files.
# For development, a relative path like "./logs" is often easier.
# For packaged deployments, "/var/log/carta" is a sensible choice.
dir = "./logs"

# Also mirror logs to stdout/stderr in addition to the log file.
also_stdout = true

# ============================================================================
# Controller Configuration
# ============================================================================
[controller]

# Authentication mode: "none", "pam", "oidc", or "both"
auth_mode = "none"

# Port for the controller HTTP/WebSocket server
port = 8081

# Hostname to bind to. If this is empty, all interfaces will be used
hostname = ""

# Directory containing the CARTA frontend static files
frontend_dir = ""

# Address of the spawner service
spawner_address = "http://localhost:8080"

# If exposing the controller to users other than at the top level of a domain
# the controller must tell the frontend where to find interfaces
api_prefix = "/api"

[controller.pam]
service_name = "carta"

[controller.oidc]
issuer_url = ""
client_id = ""
client_secret = ""
redirect_url = ""

# ============================================================================
# Spawner Configuration
# ============================================================================
[spawner]

# Path or command to the CARTA backend executable
worker_exec = "carta_backend"

# Path or command to the CARTA listing executable
list_exec = "carta-list"

# Timeout duration for spawning worker processes
timeout = "5s"

# Port for the spawner HTTP server
port = 8080

# Hostname to bind to. If this is empty, all interfaces will be used
hostname = ""

# Base directory for user data access
# References to {{{.user}}} in the string will be replaced with the username
# of the user and "{{.home}}" will be replaced by the user's home directory
base_dir_tmpl = "{{.home}}"

# Top level directory for user data access
top_level_dir = "/"
